{
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "run": "off",
    "simplify": "off",
    "loop": "off",
    "schedule": "off",
    "claude-in-chrome": "off",
    "init": "off",
    "review": "off",
    "security-review": "off",
    "claude-api": "user-invocable-only",
    "dataviz": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": false
  },
  "autoMemoryEnabled": false,
  "agentPushNotifEnabled": false,
  "model": "sonnet",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Any git command that rewrites or moves the commit graph: commit, merge, rebase, reset, revert, cherry-pick, commit --amend"
    ],
    "hard_deny": [
      "$defaults",
      "Any aws CLI command (aws ...) block unconditionally"
    ]
  }
}
